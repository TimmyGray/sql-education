# ---------------------------------------------------------------------------
# SQL Education — environment variables (development defaults).
# Copy this file to `.env` at the repo root and adjust as needed:
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
#
# The values below assume you are running services on the HOST (via the exposed
# docker-compose ports). When running the api/web INSIDE the docker network,
# swap the localhost hostnames for the compose service names — host-internal
# variants are shown in comments next to each URL.
# ---------------------------------------------------------------------------

# Primary application database (postgres service, host port 5432).
DATABASE_URL=postgresql://sql_edu:sql_edu_pw@localhost:5432/sql_edu
# In-docker: postgresql://sql_edu:sql_edu_pw@postgres:5432/sql_edu

# Sandbox database server (sandbox-postgres service, host port 5433).
# sandbox_admin is the superuser that owns/sets up datasets; sandbox_runner is a
# restricted role a later wave creates for executing untrusted user SQL.
SANDBOX_ADMIN_DATABASE_URL=postgresql://sandbox_admin:sandbox_admin_pw@localhost:5433/sandbox
# In-docker: postgresql://sandbox_admin:sandbox_admin_pw@sandbox-postgres:5432/sandbox
SANDBOX_RUNNER_DATABASE_URL=postgresql://sandbox_runner:sandbox_runner_pw@localhost:5433/sandbox
# In-docker: postgresql://sandbox_runner:sandbox_runner_pw@sandbox-postgres:5432/sandbox

# Redis (host port 6379).
REDIS_URL=redis://localhost:6379
# In-docker: redis://redis:6379

# RabbitMQ (amqp host port 5672, management UI 15672).
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# In-docker: amqp://guest:guest@rabbitmq:5672

# Mail (MailHog — SMTP 1025, web UI 8025).
# For production swap host/port/user/pass for your real SMTP provider (e.g. Mailgun).
SMTP_HOST=localhost
# In-docker: mailhog
SMTP_PORT=1025
# SMTP_USER=   # not needed for MailHog; required for real providers
# SMTP_PASS=   # not needed for MailHog; required for real providers
MAIL_FROM="SQL Education <no-reply@sql-edu.dev>"

# Auth / JWT.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AI provider (OpenRouter-compatible; the OpenAI SDK points at OPENROUTER_BASE_URL).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Servers.
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
