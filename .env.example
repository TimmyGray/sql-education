# ---------------------------------------------------------------------------
# SQL Education — environment variables (development defaults).
# Copy this file to `.env` at the repo root and adjust as needed:
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
#
# The values below assume you are running services on the HOST (via the exposed
# docker-compose ports). When running the api/web INSIDE the docker network,
# swap the localhost hostnames for the compose service names — host-internal
# variants are shown in comments next to each URL.
# ---------------------------------------------------------------------------

# Primary application database (postgres service, host port 5432).
DATABASE_URL=postgresql://sql_edu:sql_edu_pw@localhost:5432/sql_edu
# In-docker: postgresql://sql_edu:sql_edu_pw@postgres:5432/sql_edu

# Direct (non-pooled) connection used by Prisma Migrate. For local postgres this
# equals DATABASE_URL. For a pooled provider like Supabase, set DATABASE_URL to
# the pgbouncer pooler (port 6543, ?pgbouncer=true) and DIRECT_URL to the direct
# connection (port 5432).
DIRECT_URL=postgresql://sql_edu:sql_edu_pw@localhost:5432/sql_edu
# In-docker: postgresql://sql_edu:sql_edu_pw@postgres:5432/sql_edu

# The SQL sandbox that runs untrusted student queries is embedded SQLite
# (in-process, per-request in-memory DB) — no separate database to configure.

# Redis (host port 6379).
REDIS_URL=redis://localhost:6379
# In-docker: redis://redis:6379
REDIS_CLOUD_URL=
REDIS_CLOUD_TOKEN=


# AMQP broker (RabbitMQ on port 5672, management UI 15672).
# Leave unset to use the local default (amqp://guest:guest@localhost:5672).
# Set to a CloudAMQP URL for cloud-hosted RabbitMQ (amqps://user:pass@host/vhost).
AMQP_URL=

# Mail (MailHog — SMTP 1025, web UI 8025).
# For production swap host/port/user/pass for your real SMTP provider (e.g. Mailgun).
SMTP_HOST=localhost
# In-docker: mailhog
SMTP_PORT=1025
SMTP_USER=   # not needed for MailHog; required for real providers
SMTP_PASS=   # not needed for MailHog; required for real providers
MAIL_FROM="SQL Education <no-reply@sql-edu.dev>"

# Auth / JWT.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AI provider (OpenRouter-compatible; the OpenAI SDK points at OPENROUTER_BASE_URL).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
AI_MODEL=moonshotai/kimi-k2.6:free

# Servers.
HOST=localhost
PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
