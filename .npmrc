# Don't let pnpm auto-reinstall before running scripts. In the multi-stage
# Docker build the deps layer installs the packages each image needs, then
# `COPY . .` brings in the full workspace; pnpm 11's pre-run deps check would
# otherwise think node_modules is stale and trigger a fresh (network-bound)
# install — which both wastes time and fails in a no-TTY build. The deps we
# build (contracts + api / contracts + web) are already present.
verify-deps-before-run=false
